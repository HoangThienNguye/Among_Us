[Unit]
Description=Among Us herkenning, laser tracking en servo-sturing
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thien
Group=video
SupplementaryGroups=gpio
WorkingDirectory=/home/thien
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/thien/.Xauthority
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/thien/main.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
